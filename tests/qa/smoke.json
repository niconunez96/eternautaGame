    {"type": "assert", "node_path": "/root/Main/HUD/HealthLabel", "property": "text", "expected": "Health: 3 / 3", "operator": "eq"},
    {"type": "input", "action": "move_right", "pressed": true, "auto_release": false},
    {"type": "wait", "seconds": 0.35},
    {"type": "input", "action": "move_right", "pressed": false},
    {"type": "input", "action": "attack", "pressed": true, "auto_release": true},
    {"type": "wait", "seconds": 0.15},
    {"type": "assert", "node_path": "/root/Main/BasicEnemy", "property": "defeated_state", "expected": true, "operator": "eq"},
    {"type": "input", "action": "move_right", "pressed": true, "auto_release": false},
    {"type": "wait", "seconds": 0.75},
    {"type": "input", "action": "move_right", "pressed": false},
    {"type": "assert", "node_path": "/root/Main/Checkpoint", "property": "active", "expected": true, "operator": "eq"},
    {"type": "assert", "text": "Checkpoint: active", "partial": false},
    {"type": "input", "action": "move_right", "pressed": true, "auto_release": false},
    {"type": "wait", "seconds": 0.45},
    {"type": "input", "action": "move_right", "pressed": false},
    {"type": "assert", "node_path": "/root/Main", "property": "has_double_jump", "expected": true, "operator": "eq"},
    {"type": "assert", "text": "Double jump: acquired", "partial": false},
    {"type": "input", "action": "move_right", "pressed": true, "auto_release": false},
    {"type": "wait", "seconds": 0.25},
    {"type": "input", "action": "jump", "pressed": true, "auto_release": true},
    {"type": "wait", "seconds": 0.22},
    {"type": "input", "action": "jump", "pressed": true, "auto_release": true},
    {"type": "wait", "seconds": 0.1},
    {"type": "assert", "node_path": "/root/Main/Player", "property": "air_jump_available", "expected": false, "operator": "eq"},
    {"type": "wait", "seconds": 0.85},
    {"type": "input", "action": "move_right", "pressed": false},
    {"type": "assert", "node_path": "/root/Main/TraversalObstacle", "property": "landing_reached", "expected": true, "operator": "eq"},
    {"type": "assert", "node_path": "/root/Main/ExitObjective", "property": "completed", "expected": false, "operator": "eq"},
    {"type": "input", "action": "move_right", "pressed": true, "auto_release": false},
    {"type": "wait", "seconds": 0.35},
    {"type": "input", "action": "move_right", "pressed": false},
    {"type": "assert", "node_path": "/root/Main/ExitObjective", "property": "completed", "expected": true, "operator": "eq"},
    {"type": "assert", "text": "Objective complete", "partial": true}
  ]
