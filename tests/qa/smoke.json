{
  "scene_path": "res://scenes/app/main.tscn",
  "steps": [
    {"type": "wait", "node_path": "/root/Main/Player", "timeout": 3.0},
    {"type": "assert", "node_path": "/root/Main/Player", "property": "current_health", "expected": 3, "operator": "eq"},
    {"type": "assert", "node_path": "/root/Main/HUD/HealthLabel", "property": "text", "expected": "Health: 3 / 3", "operator": "eq"},
    {"type": "input", "action": "move_right", "pressed": true, "auto_release": false},
    {"type": "wait", "seconds": 0.35},
    {"type": "input", "action": "move_right", "pressed": false},
    {"type": "input", "action": "attack", "pressed": true, "auto_release": true},
    {"type": "wait", "seconds": 0.15},
    {"type": "assert", "node_path": "/root/Main/BasicEnemy", "property": "defeated_state", "expected": true, "operator": "eq"},
    {"type": "input", "action": "move_right", "pressed": true, "auto_release": false},
    {"type": "wait", "seconds": 0.75},
    {"type": "input", "action": "move_right", "pressed": false},
    {"type": "assert", "node_path": "/root/Main/Checkpoint", "property": "active", "expected": true, "operator": "eq"},
    {"type": "assert", "text": "Checkpoint: active", "partial": false},
    {"type": "input", "action": "move_right", "pressed": true, "auto_release": false},
    {"type": "wait", "seconds": 0.45},
    {"type": "input", "action": "move_right", "pressed": false},
    {"type": "assert", "node_path": "/root/Main", "property": "has_access_key", "expected": true, "operator": "eq"},
    {"type": "assert", "text": "Access key: acquired", "partial": false},
    {"type": "input", "action": "move_right", "pressed": true, "auto_release": false},
    {"type": "wait", "seconds": 0.55},
    {"type": "input", "action": "move_right", "pressed": false},
    {"type": "input", "action": "interact", "pressed": true, "auto_release": true},
    {"type": "wait", "seconds": 0.15},
    {"type": "assert", "node_path": "/root/Main/LockedDoor", "property": "unlocked", "expected": true, "operator": "eq"},
    {"type": "assert", "text": "Door unlocked", "partial": false}
  ]
}
