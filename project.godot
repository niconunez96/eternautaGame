; Godot 4.6 Steam Deck / Linux baseline.
config_version=5

[application]
config/name="EternautaGame"
run/main_scene="res://scenes/app/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")

[display]

[display/window]
size/viewport_width=1280
size/viewport_height=800
size/window_width_override=1280
size/window_height_override=800
stretch/mode="canvas_items"
stretch/aspect="expand"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false

[input]
move_left={"deadzone": 0.22, "events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventKey,"physical_keycode":4194311), Object(InputEventJoypadMotion,"axis":0,"axis_value":-1.0)]}
move_right={"deadzone": 0.22, "events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventKey,"physical_keycode":4194313), Object(InputEventJoypadMotion,"axis":0,"axis_value":1.0)]}
move_up={"deadzone": 0.22, "events": [Object(InputEventKey,"physical_keycode":87), Object(InputEventKey,"physical_keycode":4194320), Object(InputEventJoypadMotion,"axis":1,"axis_value":-1.0)]}
move_down={"deadzone": 0.22, "events": [Object(InputEventKey,"physical_keycode":83), Object(InputEventKey,"physical_keycode":4194322), Object(InputEventJoypadMotion,"axis":1,"axis_value":1.0)]}
jump={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":32), Object(InputEventJoypadButton,"button_index":0)]}
interact={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":75), Object(InputEventJoypadButton,"button_index":2)]}
pause={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":4194309), Object(InputEventJoypadButton,"button_index":6)]}
ui_accept={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":4194309), Object(InputEventJoypadButton,"button_index":0)]}
ui_cancel={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":4194305), Object(InputEventJoypadButton,"button_index":1)]}
ui_tab_left={"deadzone": 0.2, "events": [Object(InputEventJoypadButton,"button_index":9)]}
ui_tab_right={"deadzone": 0.2, "events": [Object(InputEventJoypadButton,"button_index":10)]}
